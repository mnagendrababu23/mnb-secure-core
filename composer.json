{
  "name": "mnb/mnb-secure-core",
  "description": "mnb-secure-core reusable no-framework PHP security core for custom applications.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Nagendra babu Macharla"
    }
  ],
  "keywords": [
    "mnb-secure-core",
    "php-security",
    "no-framework",
    "security-core",
    "csrf",
    "rate-limiting",
    "audit-logging"
  ],
  "require": {
    "php": ">=8.1",
    "ext-openssl": "*",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-pdo": "*"
  },
  "autoload": {
    "psr-4": {
      "Mnb\\SecurityCore\\": "src/"
    }
  },
  "bin": [
    "bin/mnb-secure"
  ],
  "scripts": {
    "test": "php tests/run-tests.php",
    "demo": "php demos/run-all-demos.php"
  },
  "extra": {
    "library-name": "mnb-secure-core",
    "release-line": "v1.0.1 Public Package Hardening"
  },
  "suggest": {
    "ext-redis": "Required for Redis cache, rate limiter, and token store drivers.",
    "ext-zip": "Recommended for ZIP backup support.",
    "clamav/clamav": "Recommended for production upload malware scanning."
  }
}
