APP_NAME="MNB Secure App"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=change_me_generate_64_chars
FORCE_HTTPS=false
TRUSTED_HOSTS=localhost,127.0.0.1
# Only these proxy/CDN/load-balancer IPs may supply X-Forwarded-* headers.
TRUSTED_PROXIES=

# Origin/server identity protection
# PHP can help block direct IP Host requests and remove app-level fingerprint headers.
# For real origin IP hiding, put the site behind a CDN/reverse proxy and firewall the origin.
ORIGIN_PROTECTION_ENABLED=true
BLOCK_DIRECT_IP_HOST=true
CDN_OR_PROXY_ENABLED=false
BLOCK_UNTRUSTED_FORWARDED_HEADERS=true
REQUIRE_TRUSTED_PROXY=false
REQUIRE_CDN_OR_PROXY_IN_PRODUCTION=true

SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

STORAGE_PRIVATE_PATH=storage/private
STORAGE_QUARANTINE_PATH=storage/quarantine
CACHE_PATH=storage/cache
LOG_PATH=storage/logs
AUDIT_PATH=storage/audit
AUDIT_ENABLED=true
AUDIT_FILE=storage/audit/security-audit.log
AUDIT_MIRROR_TO_LOG=false
AUDIT_LOG_FILE=storage/logs/security-audit.log
BACKUP_PATH=storage/backups

RATE_LIMIT_DRIVER=file
TOKEN_STORE_DRIVER=file
CACHE_DRIVER=file


# Database
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mnb_secure_core
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Error handling
ERROR_RESPONSE_FORMAT=auto
ERROR_HIDE_FRONTEND_ERRORS=true

# Memory management
MEMORY_WARNING_RATIO=0.75
MEMORY_CRITICAL_RATIO=0.90
MEMORY_DEFAULT_CHUNK_SIZE=500
MEMORY_MAX_CHUNK_SIZE=5000

# Throughput and capacity
THROUGHPUT_TARGET_RPS=50
THROUGHPUT_WARNING_LATENCY_MS=750
THROUGHPUT_CRITICAL_LATENCY_MS=2000
THROUGHPUT_MAX_CONCURRENCY=25
THROUGHPUT_QUEUE_WARNING_DEPTH=1000
THROUGHPUT_SAMPLE_WINDOW_SECONDS=60

# Optional scalable stores
# Drivers: file, redis, database
CACHE_PREFIX=mnb:cache:
CACHE_TABLE=mnb_cache
RATE_LIMIT_PREFIX=mnb:rate:
RATE_LIMIT_TABLE=mnb_rate_limits
TOKEN_STORE_FILE=storage/tokens/tokens.json
TOKEN_STORE_PREFIX=mnb:token:
TOKEN_STORE_TABLE=mnb_api_tokens

# Redis settings, used only when CACHE_DRIVER/RATE_LIMIT_DRIVER/TOKEN_STORE_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=1.5

# Upload profiles
# Built-in profiles: custom, default, images, documents, videos, archives, strict
UPLOAD_PROFILE=custom
UPLOAD_STRICT_PRODUCTION=true
UPLOAD_ALLOW_ARCHIVES_IN_PRODUCTION=false
UPLOAD_MAX_ARCHIVE_ENTRIES=500
UPLOAD_MAX_ARCHIVE_UNCOMPRESSED_BYTES=104857600

# Upload scanning
# Drivers: none, heuristic, clamav, composite
UPLOAD_SCANNER_DRIVER=heuristic
CLAMAV_BINARY=clamscan
UPLOAD_SCAN_TIMEOUT=30
UPLOAD_SCAN_FAIL_CLOSED=false
# Production recommendation when using clamav/composite: UPLOAD_SCAN_FAIL_CLOSED=true
UPLOAD_HEURISTIC_READ_BYTES=2097152
