# MNB Secure Core v1.0.1 production environment example
# Copy to .env on the production server and replace every CHANGE_ME value.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_KEY=CHANGE_ME_RUN_php_bin_mnb-secure_key_generate
FORCE_HTTPS=true
TRUSTED_HOSTS=example.com,www.example.com
TRUSTED_PROXIES=CHANGE_ME_CDN_OR_LOAD_BALANCER_IP_OR_CIDR

SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Strict

# Keep all writable/private paths outside the public web root.
STORAGE_PRIVATE_PATH=storage/private
STORAGE_QUARANTINE_PATH=storage/quarantine
CACHE_PATH=storage/cache
LOG_PATH=storage/logs
AUDIT_PATH=storage/audit
BACKUP_PATH=storage/backups
TOKEN_STORE_FILE=storage/tokens/tokens.json

AUDIT_ENABLED=true
AUDIT_FILE=storage/audit/security-audit.log
AUDIT_MIRROR_TO_LOG=false
AUDIT_LOG_FILE=storage/logs/security-audit.log
AUDIT_AUTO_ENABLED=true
AUDIT_AUTO_LOG_READS=false
AUDIT_AUTO_LOG_PREFLIGHT=false
AUDIT_AUTO_EXCLUDED_PATHS=health,healthz,metrics,favicon.ico

# file, redis, database
CACHE_DRIVER=file
RATE_LIMIT_DRIVER=file
TOKEN_STORE_DRIVER=file
CACHE_PREFIX=mnb:cache:
RATE_LIMIT_PREFIX=mnb:rate:
TOKEN_STORE_PREFIX=mnb:token:
CACHE_TABLE=mnb_cache
RATE_LIMIT_TABLE=mnb_rate_limits
TOKEN_STORE_TABLE=mnb_api_tokens

# Redis is required only when one of the drivers above is redis.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=1.5

# MySQL/MariaDB is required only when database-backed stores are enabled.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_CHARSET=utf8mb4

UPLOAD_PROFILE=documents
UPLOAD_STRICT_PRODUCTION=true
UPLOAD_ALLOW_ARCHIVES_IN_PRODUCTION=false
UPLOAD_SCANNER_DRIVER=composite
CLAMAV_BINARY=clamscan
UPLOAD_SCAN_TIMEOUT=30
UPLOAD_SCAN_FAIL_CLOSED=true
UPLOAD_HEURISTIC_READ_BYTES=2097152
UPLOAD_MAX_ARCHIVE_ENTRIES=500
UPLOAD_MAX_ARCHIVE_UNCOMPRESSED_BYTES=104857600

SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
CSP_ENABLED=true
CSP_REPORT_ONLY=false
CSP_NONCE_ENABLED=true
CSP_AUTO_NONCE=true
PERMISSIONS_POLICY_PRESET=strict

# Cross-origin / CORS
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_NULL_ORIGIN=false
CORS_ALLOW_PRIVATE_NETWORK=false
CORS_MAX_AGE=600
CROSS_ORIGIN_OPENER_POLICY=same-origin
CROSS_ORIGIN_RESOURCE_POLICY=same-origin
CROSS_ORIGIN_EMBEDDER_POLICY=

ORIGIN_PROTECTION_ENABLED=true
BLOCK_DIRECT_IP_HOST=true
CDN_OR_PROXY_ENABLED=true
REQUIRE_CDN_OR_PROXY_IN_PRODUCTION=true
BLOCK_UNTRUSTED_FORWARDED_HEADERS=true
REQUIRE_TRUSTED_PROXY=false

MEMORY_WARNING_RATIO=0.75
MEMORY_CRITICAL_RATIO=0.90
MEMORY_DEFAULT_CHUNK_SIZE=500
MEMORY_MAX_CHUNK_SIZE=5000

THROUGHPUT_TARGET_RPS=50
THROUGHPUT_WARNING_LATENCY_MS=750
THROUGHPUT_CRITICAL_LATENCY_MS=2000
THROUGHPUT_MAX_CONCURRENCY=25
THROUGHPUT_QUEUE_WARNING_DEPTH=1000
THROUGHPUT_SAMPLE_WINDOW_SECONDS=60

PENTEST_REPORT_PATH=storage/logs

# Developer suggestion helper
# Trust Zones and Data Boundaries
TRUST_BOUNDARIES_ENABLED=true
TRUST_BOUNDARY_HIDE_DENIAL_REASONS=true
TRUST_BOUNDARY_DENY_UNCLASSIFIED_FIELDS=true

SUGGESTIONS_ENABLED=true
SUGGESTIONS_MAX_RESULTS=8

# Request input validation and sanitization
REQUEST_VALIDATION_ENABLED=true
REQUEST_SANITIZE_ENABLED=true
REQUEST_VALIDATION_MAX_DEPTH=10
REQUEST_VALIDATION_MAX_STRING_LENGTH=10000

# Secure Request Receiving Strategy Engine
REQUEST_RECEIVING_ENABLED=true
REQUEST_ID_HEADER=X-Request-ID
REQUEST_ID_ACCEPT_INCOMING=true
REQUEST_ID_MAX_LENGTH=80
REQUEST_JSON_DEPTH=64
REQUEST_JSON_MAX_BYTES=1048576
REQUEST_MAX_PATH_LENGTH=2048
REQUEST_MAX_PARAMETERS=200
SUSPICIOUS_REQUEST_MODE=block
WEBHOOK_SIGNATURE_HEADER=X-Signature
WEBHOOK_TIMESTAMP_HEADER=X-Timestamp
WEBHOOK_SIGNATURE_ALGORITHM=sha256
WEBHOOK_SECRET=
WEBHOOK_TIMESTAMP_TOLERANCE=300

# Authentication strategy engine
AUTHENTICATION_ENABLED=true
AUTH_TOKEN_TTL_SECONDS=2592000
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_MIXED_CASE=false
PASSWORD_REQUIRE_NUMBER=false
PASSWORD_REQUIRE_SYMBOL=false
PASSWORD_BLOCK_COMMON=true
PASSWORD_BLOCK_USER_CONTEXT=true

# Authorization Strategy Engine
AUTHORIZATION_ENABLED=true
AUTHORIZATION_DENY_BY_DEFAULT=true
AUTHORIZATION_AUDIT_DENIALS=true
AUTHORIZATION_HIDE_DENIAL_REASONS=true
