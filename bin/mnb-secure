        echo "  queue:work               Process queued jobs: queue [--once] [--max-jobs=N]
";
        echo "  queue:status             Show job status by id
";
        echo "  queue:failed             List failed jobs
";
        echo "  queue:retry              Retry job by id
";
        echo "  queue:dead-letter        List dead-letter jobs
";
        echo "  queue:metrics            Show queue metrics
";
        echo "  queue:pressure           Show queue pressure report
";
        echo "  queue:handlers           List registered job handlers
";
        echo "  queue:release-gate       Evaluate queue release gate
";
        break;
}
