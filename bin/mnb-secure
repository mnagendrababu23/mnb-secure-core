#!/usr/bin/env php
<?php
require __DIR__ . '/../autoload.php';

use Mnb\SecurityCore\Env\EnvLoader;
use Mnb\SecurityCore\Env\SecretScanner;
use Mnb\SecurityCore\Security\ProductionSecurityChecker;
use Mnb\SecurityCore\Security\SecurityConfigValidator;
use Mnb\SecurityCore\Security\SecurityDoctor;
use Mnb\SecurityCore\Security\VulnerabilityMatrix;
use Mnb\SecurityCore\Pentest\PentestChecklist;
use Mnb\SecurityCore\Pentest\PayloadLibrary;
use Mnb\SecurityCore\Pentest\PentestReportBuilder;
use Mnb\SecurityCore\Pentest\VerificationMatrix;
use Mnb\SecurityCore\Pentest\PentestFinding;
use Mnb\SecurityCore\Pentest\RiskRating;
use Mnb\SecurityCore\Pentest\RetestResult;
use Mnb\SecurityCore\Pentest\VerificationResult;
use Mnb\SecurityCore\Pentest\VerificationTarget;
use Mnb\SecurityCore\Errors\SafeErrorHandler;
use Mnb\SecurityCore\Errors\ErrorPolicy;
use Mnb\SecurityCore\Errors\ErrorCatalog;
use Mnb\SecurityCore\Errors\ErrorFingerprint;
use Mnb\SecurityCore\Errors\ErrorLogSanitizer;
use Mnb\SecurityCore\Exceptions\AppException;
use Mnb\SecurityCore\Exceptions\ValidationException;
use Mnb\SecurityCore\Exceptions\SecurityException;
use Mnb\SecurityCore\Http\Request;
use Mnb\SecurityCore\Logging\FileLogger;
use Mnb\SecurityCore\Memory\MemoryConfig;
use Mnb\SecurityCore\Memory\MemoryGuard;
use Mnb\SecurityCore\Memory\MemoryPolicy;
use Mnb\SecurityCore\Memory\StreamGuard;
use Mnb\SecurityCore\Memory\PayloadSizeGuard;
use Mnb\SecurityCore\Memory\DecodedPayloadGuard;
use Mnb\SecurityCore\Throughput\ThroughputConfig;
use Mnb\SecurityCore\Throughput\ThroughputPlanner;
use Mnb\SecurityCore\Throughput\LoadTestProfile;
use Mnb\SecurityCore\Quickstart\FirstTokenBootstrapper;
use Mnb\SecurityCore\Core\SecurityKernel;

$command = $argv[1] ?? 'help';
$root = getcwd();
$envFile = $root . '/.env';
if (is_file($envFile)) {
    EnvLoader::load($envFile);
}
$configFile = $root . '/config/security.php';
$config = is_file($configFile) ? require $configFile : (is_file(__DIR__ . '/../config/security.php') ? require __DIR__ . '/../config/security.php' : []);

switch ($command) {
    case 'key:generate':
        echo bin2hex(random_bytes(32)) . PHP_EOL;
        break;
    case 'config:validate':
        $report = (new SecurityConfigValidator($config))->validate();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit($report['passed'] ? 0 : 1);
    case 'check:production':
        $report = (new ProductionSecurityChecker($config, $root))->check();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit($report['passed'] ? 0 : 1);
    case 'doctor':
        $report = (new SecurityDoctor($config, $root))->check();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit($report['passed'] ? 0 : 1);
    case 'bootstrap:first-token':
        $userId = $argv[2] ?? 'demo-admin';
        $scopes = isset($argv[3]) ? array_filter(array_map('trim', explode(',', (string)$argv[3]))) : ['admin:*', 'profile.read', 'uploads.write'];
        $ttlSeconds = isset($argv[4]) ? (int)$argv[4] : 86400;
        $writeDemoUser = in_array('--write-demo-user', $argv, true);
        $report = (new FirstTokenBootstrapper($config, $root))->issue([
            'user_id' => $userId,
            'scopes' => $scopes,
            'ttl_seconds' => $ttlSeconds,
            'write_demo_user' => $writeDemoUser,
        ]);
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        break;
    case 'secrets:scan':
        $scannerPolicy = is_array($config['secrets']['scanning'] ?? null) ? $config['secrets']['scanning'] : [];
        $report = (new SecretScanner($scannerPolicy))->report($root);
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit($report['passed'] ? 0 : 1);
    case 'secrets:inventory':
    case 'secrets:audit':
        $kernel = new SecurityKernel($config);
        $report = $kernel->secretHealthReport()->toArray();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit($report['passed'] ? 0 : 1);
    case 'secrets:rotate-plan':
        $kernel = new SecurityKernel($config);
        $report = $kernel->secretRotationReport()->toArray();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit($report['passed'] ? 0 : 1);
    case 'secrets:env-check':
        $kernel = new SecurityKernel($config);
        $report = $kernel->environmentValidator()->validate();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit($report['passed'] ? 0 : 1);

    case 'audit:verify':
        $kernel = new SecurityKernel($config);
        $report = $kernel->auditIntegrityVerifier()->verify();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'audit:export':
        $kernel = new SecurityKernel($config);
        $category = $argv[2] ?? null;
        $limit = isset($argv[3]) ? (int)$argv[3] : null;
        $report = $kernel->auditExporter()->export($category !== '' ? $category : null, $limit);
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'logs:purge':
        $kernel = new SecurityKernel($config);
        $channel = $argv[2] ?? null;
        $report = $kernel->logRetentionManager()->purge($channel !== '' ? $channel : null);
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'monitor:summary':
        $kernel = new SecurityKernel($config);
        $report = $kernel->monitoringSummary()->toArray();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'monitor:alerts':
        $kernel = new SecurityKernel($config);
        $report = $kernel->alertManager()->summary();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);

    case 'backup:create':
        $kernel = new SecurityKernel($config);
        $type = $argv[2] ?? 'manual';
        $report = $kernel->secureBackupManager()->create($type);
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'backup:verify':
        $kernel = new SecurityKernel($config);
        $backup = $argv[2] ?? '';
        if ($backup === '') {
            $status = $kernel->recoveryStatusReport()->toArray();
            $backup = (string)($status['latest_backup']['path'] ?? '');
        }
        $report = $backup !== '' ? $kernel->backupIntegrityVerifier()->verify($backup) : ['passed' => false, 'error' => 'backup_path_required'];
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'backup:list':
        $kernel = new SecurityKernel($config);
        $path = $kernel->backupPolicy()->path();
        $items = [];
        if (is_dir($path)) {
            foreach (new DirectoryIterator($path) as $file) {
                if ($file->isFile() && preg_match('/\.(zip|enc)$/', $file->getFilename())) {
                    $items[] = ['name' => $file->getFilename(), 'path' => $file->getPathname(), 'bytes' => $file->getSize(), 'mtime' => date('c', $file->getMTime())];
                }
            }
        }
        echo json_encode(['passed' => true, 'path' => $path, 'count' => count($items), 'backups' => $items], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'backup:purge':
        $kernel = new SecurityKernel($config);
        $report = $kernel->backupRetentionManager()->purge();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'recovery:status':
        $kernel = new SecurityKernel($config);
        $report = $kernel->recoveryStatusReport()->toArray();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'recovery:drill':
        $kernel = new SecurityKernel($config);
        $backup = $kernel->secureBackupManager()->create('drill');
        $dryRun = $kernel->restoreManager()->dryRun((string)$backup['path'])->toArray();
        $report = ['passed' => !empty($backup['passed']) && !empty($dryRun['passed']), 'backup' => $backup, 'restore_dry_run' => $dryRun];
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'restore:dry-run':
        $kernel = new SecurityKernel($config);
        $backup = $argv[2] ?? '';
        $report = $backup !== '' ? $kernel->restoreManager()->dryRun($backup)->toArray() : ['passed' => false, 'error' => 'backup_path_required'];
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'incident:open':
        $kernel = new SecurityKernel($config);
        $type = $argv[2] ?? 'manual';
        $severity = $argv[3] ?? 'medium';
        $incident = $kernel->incidentResponse()->open($type, $severity, ['source' => 'cli']);
        echo json_encode($incident->toArray(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'incident:run-playbook':
        $kernel = new SecurityKernel($config);
        $playbook = $argv[2] ?? 'manual';
        $report = $kernel->incidentResponse()->runPlaybook($playbook, ['source' => 'cli'])->toArray();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'incident:report':
        $kernel = new SecurityKernel($config);
        $report = $kernel->incidentResponse()->summary();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'runtime:list-commands':
        $kernel = new SecurityKernel($config);
        echo json_encode(['passed' => true, 'runtime' => $kernel->processPolicy()->toArray()], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'runtime:check-command':
        $kernel = new SecurityKernel($config);
        $name = $argv[2] ?? '';
        $args = array_slice($argv, 3);
        $report = $name !== '' ? $kernel->safeProcessRunner()->check($name, $args) : ['passed' => false, 'error' => 'command_name_required'];
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'outbound:policy':
        $kernel = new SecurityKernel($config);
        echo json_encode(['passed' => true, 'outbound' => $kernel->outboundRequestPolicy()->toArray()], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'outbound:check-url':
        $kernel = new SecurityKernel($config);
        $url = $argv[2] ?? '';
        $report = $url !== '' ? $kernel->outboundHttpClient()->checkUrl($url) : ['passed' => false, 'error' => 'url_required'];
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'db:health':
        $kernel = new SecurityKernel($config);
        $report = $kernel->databaseHealthChecker()->check(false);
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'db:check-connection':
        $kernel = new SecurityKernel($config);
        try {
            $report = $kernel->databaseHealthChecker(new \Mnb\SecurityCore\Database\PdoDatabaseConnection($kernel->pdo()))->check(true);
        } catch (Throwable $e) {
            $report = ['passed' => false, 'error' => 'connection_failed', 'error_class' => get_class($e), 'message' => 'Database connection could not be established.'];
        }
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'db:policy':
        $kernel = new SecurityKernel($config);
        echo json_encode(['passed' => true, 'operation_policy' => $kernel->databaseOperationPolicy()->toArray(), 'schema_policy' => $kernel->schemaChangePolicy()->toArray()], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'db:query-limits':
        $kernel = new SecurityKernel($config);
        echo json_encode(['passed' => true, 'query_limits' => $kernel->databaseQueryCostPolicy()->toArray()], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'db:schema-plan':
        $kernel = new SecurityKernel($config);
        $operation = $argv[2] ?? 'add_column';
        $table = $argv[3] ?? 'example_table';
        $column = $argv[4] ?? 'example_column';
        $type = $argv[5] ?? 'VARCHAR(100)';
        $context = new \Mnb\SecurityCore\Authz\TenantContext(userId: 'cli', roles: ['super_admin'], permissions: ['schema.alter']);
        try {
            if ($operation === 'add_index') {
                $columns = array_slice($argv, 5) ?: ['id'];
                $plan = $kernel->schemaMigrationGuard()->planAddIndex($context, $table, $column, $columns, true);
            } elseif ($operation === 'add_column') {
                $plan = $kernel->schemaMigrationGuard()->planAddColumn($context, $table, $column, $type, true, null, true);
            } else {
                $plan = $kernel->schemaMigrationGuard()->planDestructive($context, $operation, $table);
            }
            $report = ['passed' => $plan->allowed, 'schema_plan' => $plan->toArray()];
        } catch (Throwable $e) {
            $report = ['passed' => false, 'error' => 'schema_plan_failed', 'error_class' => get_class($e), 'message' => $e->getMessage()];
        }
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'db:privileges':
        $kernel = new SecurityKernel($config);
        $grants = array_slice($argv, 2);
        $report = $kernel->databasePrivilegeInspector($grants)->inspect();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'vulnerabilities:matrix':
    case 'matrix:export':
        $kernel = new SecurityKernel($config);
        $report = $kernel->vulnerabilityMatrix()->toArray();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'vulnerabilities:report':
        $kernel = new SecurityKernel($config);
        $report = $kernel->vulnerabilityCoverageReport()->toArray();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'vulnerabilities:check':
        $kernel = new SecurityKernel($config);
        $id = $argv[2] ?? '';
        $report = $id !== '' ? $kernel->vulnerabilityAdvisor()->recommend($id) : ['passed' => false, 'error' => 'vulnerability_id_required'];
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'vulnerabilities:owasp':
        $kernel = new SecurityKernel($config);
        $rows = [];
        foreach ($kernel->vulnerabilityMatrix()->rows() as $row) {
            foreach ((array)($row['owasp'] ?? []) as $owasp) {
                $rows[(string)$owasp][] = ['id' => $row['id'], 'name' => $row['name'], 'status' => $row['status'], 'score' => $row['score']];
            }
        }
        ksort($rows);
        echo json_encode(['passed' => true, 'framework' => 'OWASP Top 10 2021', 'groups' => $rows], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'vulnerabilities:export':
        $kernel = new SecurityKernel($config);
        echo $kernel->vulnerabilityReportExporter()->markdown();
        exit(0);
    case 'pentest:checklist':
        echo json_encode((new PentestChecklist())->grouped(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        break;
    case 'pentest:payloads':
        echo json_encode((new PayloadLibrary())->all(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        break;
    case 'pentest:matrix':
        echo json_encode((new VerificationMatrix())->all(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        break;
    case 'pentest:report-template':
        echo (new PentestReportBuilder())->buildMarkdown('Application Name', ['Web admin', 'API', 'Database', 'Files'], []);
        break;
    case 'pentest:run-checklist':
        $kernel = new SecurityKernel($config);
        $profile = $kernel->verificationProfile($argv[2] ?? 'production_release');
        $target = VerificationTarget::application('Application', $config['app']['url'] ?? null);
        $run = $kernel->securityVerificationRunner()->runProfile($profile, $target);
        echo json_encode(['passed' => true, 'verification_run' => $run->toArray()], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'pentest:verify':
        $kernel = new SecurityKernel($config);
        $testId = $argv[2] ?? '';
        if ($testId === '') {
            echo json_encode(['passed' => false, 'error' => 'test_id_required'], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
            exit(1);
        }
        try {
            $result = $kernel->securityVerificationRunner()->verify($testId, VerificationTarget::application('Application', $config['app']['url'] ?? null));
            echo json_encode(['passed' => true, 'result' => $result->toArray()], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
            exit(0);
        } catch (Throwable $e) {
            echo json_encode(['passed' => false, 'error' => 'verification_failed', 'message' => $e->getMessage()], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
            exit(1);
        }
    case 'pentest:evidence':
        $kernel = new SecurityKernel($config);
        $collector = $kernel->evidenceCollector();
        $collector->collect('http_response', 'sample redaction', [
            'headers' => ['Authorization' => 'Bearer demo-secret-token', 'Cookie' => 'sid=secret'],
            'body' => 'password=secret token=abc123 /var/www/private/app.php',
        ]);
        $bundle = $collector->bundle(['source' => 'cli']);
        $stored = $kernel->evidenceStore()->store($bundle);
        echo json_encode(['passed' => true, 'evidence_bundle' => $bundle->toArray(), 'store' => $stored], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'pentest:coverage':
        $kernel = new SecurityKernel($config);
        $profile = $kernel->verificationProfile($argv[2] ?? 'production_release');
        $target = VerificationTarget::application('Application', $config['app']['url'] ?? null);
        $run = $kernel->securityVerificationRunner()->runProfile($profile, $target);
        $report = $kernel->securityCoverageAnalyzer()->analyze($run->results(), $profile)->toArray();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'pentest:remediation-plan':
        $kernel = new SecurityKernel($config);
        $finding = new PentestFinding('FIND-PT-REL-001', 'Sample open Critical finding', RiskRating::CRITICAL, 'release', 'Application', ['Run release gate'], [], 'Release could ship with known vulnerability.', 'Critical finding remains open.', 'Fix finding and attach retest evidence.');
        $plan = \Mnb\SecurityCore\Pentest\RemediationPlan::fromFinding($finding, $kernel->remediationPolicy(), ['PT-REL-001']);
        echo json_encode(['passed' => true, 'remediation_plan' => $plan->toArray()], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'pentest:retest':
        $kernel = new SecurityKernel($config);
        $finding = new PentestFinding('FIND-PT-REL-002', 'Sample High finding fixed without retest', RiskRating::HIGH, 'release', 'Application', ['Fix finding'], [], 'Risk remains until verified.', 'Fix has not been retested.', 'Run retest and attach evidence.', 'Fixed');
        $blocked = $kernel->retestGate()->canClose($finding);
        $passed = $kernel->retestGate()->canClose($finding, RetestResult::pass($finding->id, [], [], 'Retest evidence attached.'));
        echo json_encode(['passed' => true, 'without_retest' => $blocked, 'with_retest' => $passed], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'security:release-gate':
        $kernel = new SecurityKernel($config);
        $profile = $kernel->verificationProfile($argv[2] ?? 'production_release');
        $target = VerificationTarget::application('Application', $config['app']['url'] ?? null);
        $run = $kernel->securityVerificationRunner()->runProfile($profile, $target, VerificationResult::PASSED);
        $report = $kernel->securityReleaseGate()->evaluate([], $run)->toArray();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'memory:check':
        $memoryConfig = MemoryConfig::fromArray($config['memory'] ?? []);
        $guard = new MemoryGuard($memoryConfig);
        echo json_encode([
            'memory_limit' => $memoryConfig->isUnlimited() ? 'unlimited' : MemoryGuard::bytesToHuman($memoryConfig->maxBytes()),
            'warning_at' => $memoryConfig->isUnlimited() ? null : MemoryGuard::bytesToHuman($memoryConfig->warningBytes()),
            'critical_at' => $memoryConfig->isUnlimited() ? null : MemoryGuard::bytesToHuman($memoryConfig->criticalBytes()),
            'snapshot' => $guard->snapshot('cli-memory-check')->toArray(),
        ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        break;
    case 'memory:sample-plan':
        $memoryConfig = MemoryConfig::fromArray($config['memory'] ?? []);
        $guard = new MemoryGuard($memoryConfig);
        $averageItemBytes = (int)($argv[2] ?? 2048);
        echo json_encode([
            'average_item_bytes' => $averageItemBytes,
            'recommended_chunk_size' => $guard->recommendedChunkSize($averageItemBytes),
            'default_chunk_size' => $memoryConfig->defaultChunkSize(),
            'min_chunk_size' => $memoryConfig->minChunkSize(),
            'max_chunk_size' => $memoryConfig->maxChunkSize(),
        ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        break;
    case 'memory:policy':
        $kernel = new SecurityKernel($config);
        echo json_encode(['passed' => true, 'memory' => $kernel->memoryPolicy()->toArray()], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'memory:profile':
        $kernel = new SecurityKernel($config);
        $profile = $argv[2] ?? 'request';
        echo json_encode(['passed' => true, 'profile' => $kernel->memoryPolicy()->profile($profile)->toArray()], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'memory:simulate-allocation':
        $kernel = new SecurityKernel($config);
        $bytes = (int)($argv[2] ?? 10485760);
        $operation = $argv[3] ?? 'request';
        $decision = $kernel->memoryPolicy()->decideAllocation($operation, $bytes);
        echo json_encode($decision->toArray(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit($decision->allowed() ? 0 : 1);
    case 'memory:stream-plan':
        $kernel = new SecurityKernel($config);
        $bytes = (int)($argv[2] ?? 52428800);
        $mode = $argv[3] ?? 'read';
        echo json_encode($kernel->streamGuard()->plan($bytes, $mode), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'memory:payload-check':
        $kernel = new SecurityKernel($config);
        $sample = ['safe' => true, 'items' => range(1, 5)];
        try {
            $kernel->decodedPayloadGuard()->assertSafe($sample);
            $report = ['passed' => true, 'payload' => 'safe_sample'];
        } catch (Throwable $e) {
            $report = ['passed' => false, 'error' => $e->getMessage()];
        }
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'memory:worker-check':
        $kernel = new SecurityKernel($config);
        $jobs = (int)($argv[2] ?? 10);
