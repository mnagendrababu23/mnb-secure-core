    case 'errors:simulate':
        $type = $argv[2] ?? 'internal';
        $config['app']['env'] = $config['app']['env'] ?? 'production';
        $config['app']['debug'] = false;
        $config['errors']['response_format'] = $config['errors']['response_format'] ?? 'json';
        $logPath = ($config['paths']['logs'] ?? ($root . '/storage/logs')) . '/cli-error-simulate.log';
        $handler = new SafeErrorHandler(new FileLogger($logPath), $config);
        $throwable = match ($type) {
            'validation' => new ValidationException(['password_hash' => ['users.password_hash column invalid'], 'email' => ['Email is required']]),
            'security' => new SecurityException('Blocked SSRF attempt token=secret http://127.0.0.1/admin'),
            default => new RuntimeException('SQLSTATE[HY000] database password=secret /var/www/private.php'),
        };
        $response = $handler->renderThrowable($throwable, new Request('GET', '/cli/errors/' . $type, [], [], ['accept' => 'application/json']));
        echo $response->body() . PHP_EOL;
        break;
    case 'errors:fingerprint':
        $policy = ErrorPolicy::fromConfig($config);
        $catalog = ErrorCatalog::fromConfig($config);
        $mapper = new Mnb\SecurityCore\Errors\ExceptionMapper($catalog, new Mnb\SecurityCore\Errors\ValidationErrorNormalizer($policy));
        $context = Mnb\SecurityCore\Errors\ErrorContext::fromRequest(new Request('GET', '/cli/errors/fingerprint'), $config);
        $throwable = new RuntimeException($argv[2] ?? 'Sample exception token=secret');
        $mapped = $mapper->map($throwable);
        $fingerprint = (new ErrorFingerprint($policy, new ErrorLogSanitizer($policy)))->create($throwable, $context, $mapped, ['path' => '/cli/errors/fingerprint']);
        echo json_encode(['fingerprint' => $fingerprint, 'code' => $mapped['error_code'], 'request_id' => $context->requestId], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        break;
