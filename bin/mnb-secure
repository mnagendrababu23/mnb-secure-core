    case 'queue:work':
        $kernel = new SecurityKernel($config);
        $queueName = $argv[2] ?? 'default';
        $store = $kernel->queueStore();
        $worker = $kernel->queueWorker($store, $kernel->jobHandlerRegistry());
        $maxJobs = 1;
        foreach ($argv as $arg) { if (str_starts_with($arg, '--max-jobs=')) { $maxJobs = max(1, (int)substr($arg, 11)); } }
        $runs = [];
        for ($i = 0; $i < $maxJobs; $i++) {
            $runs[] = $worker->workOnce($queueName);
            if (!empty($runs[$i]['reason']) && $runs[$i]['reason'] === 'no_job_available') { break; }
            if (in_array('--once', $argv, true)) { break; }
        }
        echo json_encode(['passed' => true, 'queue' => $queueName, 'runs' => $runs], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        break;
