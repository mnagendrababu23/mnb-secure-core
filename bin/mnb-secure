#!/usr/bin/env php
<?php
require __DIR__ . '/../autoload.php';

use Mnb\SecurityCore\Env\EnvLoader;
use Mnb\SecurityCore\Env\SecretScanner;
use Mnb\SecurityCore\Security\ProductionSecurityChecker;
use Mnb\SecurityCore\Security\SecurityConfigValidator;
use Mnb\SecurityCore\Security\SecurityDoctor;
use Mnb\SecurityCore\Security\VulnerabilityMatrix;
use Mnb\SecurityCore\Pentest\PentestChecklist;
use Mnb\SecurityCore\Pentest\PayloadLibrary;
use Mnb\SecurityCore\Pentest\PentestReportBuilder;
use Mnb\SecurityCore\Pentest\VerificationMatrix;
use Mnb\SecurityCore\Errors\SafeErrorHandler;
use Mnb\SecurityCore\Exceptions\AppException;
use Mnb\SecurityCore\Http\Request;
use Mnb\SecurityCore\Logging\FileLogger;
use Mnb\SecurityCore\Memory\MemoryConfig;
use Mnb\SecurityCore\Memory\MemoryGuard;
use Mnb\SecurityCore\Throughput\ThroughputConfig;
use Mnb\SecurityCore\Throughput\ThroughputPlanner;
use Mnb\SecurityCore\Quickstart\FirstTokenBootstrapper;
use Mnb\SecurityCore\Core\SecurityKernel;

$command = $argv[1] ?? 'help';
$root = getcwd();
$envFile = $root . '/.env';
if (is_file($envFile)) {
    EnvLoader::load($envFile);
}
$configFile = $root . '/config/security.php';
$config = is_file($configFile) ? require $configFile : (is_file(__DIR__ . '/../config/security.php') ? require __DIR__ . '/../config/security.php' : []);

switch ($command) {
    case 'key:generate':
        echo bin2hex(random_bytes(32)) . PHP_EOL;
        break;
    case 'config:validate':
        $report = (new SecurityConfigValidator($config))->validate();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit($report['passed'] ? 0 : 1);
    case 'check:production':
        $report = (new ProductionSecurityChecker($config, $root))->check();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit($report['passed'] ? 0 : 1);
    case 'doctor':
        $report = (new SecurityDoctor($config, $root))->check();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit($report['passed'] ? 0 : 1);
    case 'bootstrap:first-token':
        $userId = $argv[2] ?? 'demo-admin';
        $scopes = isset($argv[3]) ? array_filter(array_map('trim', explode(',', (string)$argv[3]))) : ['admin:*', 'profile.read', 'uploads.write'];
        $ttlSeconds = isset($argv[4]) ? (int)$argv[4] : 86400;
        $writeDemoUser = in_array('--write-demo-user', $argv, true);
        $report = (new FirstTokenBootstrapper($config, $root))->issue([
            'user_id' => $userId,
            'scopes' => $scopes,
            'ttl_seconds' => $ttlSeconds,
            'write_demo_user' => $writeDemoUser,
        ]);
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        break;
    case 'secrets:scan':
        $scannerPolicy = is_array($config['secrets']['scanning'] ?? null) ? $config['secrets']['scanning'] : [];
        $report = (new SecretScanner($scannerPolicy))->report($root);
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit($report['passed'] ? 0 : 1);
    case 'secrets:inventory':
    case 'secrets:audit':
        $kernel = new SecurityKernel($config);
        $report = $kernel->secretHealthReport()->toArray();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit($report['passed'] ? 0 : 1);
    case 'secrets:rotate-plan':
        $kernel = new SecurityKernel($config);
        $report = $kernel->secretRotationReport()->toArray();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit($report['passed'] ? 0 : 1);
    case 'secrets:env-check':
        $kernel = new SecurityKernel($config);
        $report = $kernel->environmentValidator()->validate();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit($report['passed'] ? 0 : 1);

    case 'audit:verify':
        $kernel = new SecurityKernel($config);
        $report = $kernel->auditIntegrityVerifier()->verify();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'audit:export':
        $kernel = new SecurityKernel($config);
        $category = $argv[2] ?? null;
        $limit = isset($argv[3]) ? (int)$argv[3] : null;
        $report = $kernel->auditExporter()->export($category !== '' ? $category : null, $limit);
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'logs:purge':
        $kernel = new SecurityKernel($config);
        $channel = $argv[2] ?? null;
        $report = $kernel->logRetentionManager()->purge($channel !== '' ? $channel : null);
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'monitor:summary':
        $kernel = new SecurityKernel($config);
        $report = $kernel->monitoringSummary()->toArray();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'monitor:alerts':
        $kernel = new SecurityKernel($config);
        $report = $kernel->alertManager()->summary();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);

    case 'backup:create':
        $kernel = new SecurityKernel($config);
        $type = $argv[2] ?? 'manual';
        $report = $kernel->secureBackupManager()->create($type);
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'backup:verify':
        $kernel = new SecurityKernel($config);
        $backup = $argv[2] ?? '';
        if ($backup === '') {
            $status = $kernel->recoveryStatusReport()->toArray();
            $backup = (string)($status['latest_backup']['path'] ?? '');
        }
        $report = $backup !== '' ? $kernel->backupIntegrityVerifier()->verify($backup) : ['passed' => false, 'error' => 'backup_path_required'];
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'backup:list':
        $kernel = new SecurityKernel($config);
        $path = $kernel->backupPolicy()->path();
        $items = [];
        if (is_dir($path)) {
            foreach (new DirectoryIterator($path) as $file) {
                if ($file->isFile() && preg_match('/\.(zip|enc)$/', $file->getFilename())) {
                    $items[] = ['name' => $file->getFilename(), 'path' => $file->getPathname(), 'bytes' => $file->getSize(), 'mtime' => date('c', $file->getMTime())];
                }
            }
        }
        echo json_encode(['passed' => true, 'path' => $path, 'count' => count($items), 'backups' => $items], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'backup:purge':
        $kernel = new SecurityKernel($config);
        $report = $kernel->backupRetentionManager()->purge();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'recovery:status':
        $kernel = new SecurityKernel($config);
        $report = $kernel->recoveryStatusReport()->toArray();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'recovery:drill':
        $kernel = new SecurityKernel($config);
        $backup = $kernel->secureBackupManager()->create('drill');
        $dryRun = $kernel->restoreManager()->dryRun((string)$backup['path'])->toArray();
        $report = ['passed' => !empty($backup['passed']) && !empty($dryRun['passed']), 'backup' => $backup, 'restore_dry_run' => $dryRun];
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'restore:dry-run':
        $kernel = new SecurityKernel($config);
        $backup = $argv[2] ?? '';
        $report = $backup !== '' ? $kernel->restoreManager()->dryRun($backup)->toArray() : ['passed' => false, 'error' => 'backup_path_required'];
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'incident:open':
        $kernel = new SecurityKernel($config);
        $type = $argv[2] ?? 'manual';
        $severity = $argv[3] ?? 'medium';
        $incident = $kernel->incidentResponse()->open($type, $severity, ['source' => 'cli']);
        echo json_encode($incident->toArray(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'incident:run-playbook':
        $kernel = new SecurityKernel($config);
        $playbook = $argv[2] ?? 'manual';
        $report = $kernel->incidentResponse()->runPlaybook($playbook, ['source' => 'cli'])->toArray();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'incident:report':
        $kernel = new SecurityKernel($config);
        $report = $kernel->incidentResponse()->summary();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'runtime:list-commands':
        $kernel = new SecurityKernel($config);
        echo json_encode(['passed' => true, 'runtime' => $kernel->processPolicy()->toArray()], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'runtime:check-command':
        $kernel = new SecurityKernel($config);
        $name = $argv[2] ?? '';
        $args = array_slice($argv, 3);
        $report = $name !== '' ? $kernel->safeProcessRunner()->check($name, $args) : ['passed' => false, 'error' => 'command_name_required'];
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'outbound:policy':
        $kernel = new SecurityKernel($config);
        echo json_encode(['passed' => true, 'outbound' => $kernel->outboundRequestPolicy()->toArray()], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'outbound:check-url':
        $kernel = new SecurityKernel($config);
        $url = $argv[2] ?? '';
        $report = $url !== '' ? $kernel->outboundHttpClient()->checkUrl($url) : ['passed' => false, 'error' => 'url_required'];
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'vulnerabilities:matrix':
    case 'matrix:export':
        $kernel = new SecurityKernel($config);
        $report = $kernel->vulnerabilityMatrix()->toArray();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'vulnerabilities:report':
        $kernel = new SecurityKernel($config);
        $report = $kernel->vulnerabilityCoverageReport()->toArray();
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'vulnerabilities:check':
        $kernel = new SecurityKernel($config);
        $id = $argv[2] ?? '';
        $report = $id !== '' ? $kernel->vulnerabilityAdvisor()->recommend($id) : ['passed' => false, 'error' => 'vulnerability_id_required'];
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(!empty($report['passed']) ? 0 : 1);
    case 'vulnerabilities:owasp':
        $kernel = new SecurityKernel($config);
        $rows = [];
        foreach ($kernel->vulnerabilityMatrix()->rows() as $row) {
            foreach ((array)($row['owasp'] ?? []) as $owasp) {
                $rows[(string)$owasp][] = ['id' => $row['id'], 'name' => $row['name'], 'status' => $row['status'], 'score' => $row['score']];
            }
        }
        ksort($rows);
        echo json_encode(['passed' => true, 'framework' => 'OWASP Top 10 2021', 'groups' => $rows], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        exit(0);
    case 'vulnerabilities:export':
        $kernel = new SecurityKernel($config);
        echo $kernel->vulnerabilityReportExporter()->markdown();
        exit(0);
    case 'pentest:checklist':
        echo json_encode((new PentestChecklist())->grouped(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        break;
    case 'pentest:payloads':
        echo json_encode((new PayloadLibrary())->all(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        break;
    case 'pentest:matrix':
        echo json_encode((new VerificationMatrix())->all(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        break;
    case 'pentest:report-template':
        echo (new PentestReportBuilder())->buildMarkdown('Application Name', ['Web admin', 'API', 'Database', 'Files'], []);
        break;
    case 'memory:check':
        $memoryConfig = MemoryConfig::fromArray($config['memory'] ?? []);
        $guard = new MemoryGuard($memoryConfig);
        echo json_encode([
            'memory_limit' => $memoryConfig->isUnlimited() ? 'unlimited' : MemoryGuard::bytesToHuman($memoryConfig->maxBytes()),
            'warning_at' => $memoryConfig->isUnlimited() ? null : MemoryGuard::bytesToHuman($memoryConfig->warningBytes()),
            'critical_at' => $memoryConfig->isUnlimited() ? null : MemoryGuard::bytesToHuman($memoryConfig->criticalBytes()),
            'snapshot' => $guard->snapshot('cli-memory-check')->toArray(),
        ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        break;
    case 'memory:sample-plan':
        $memoryConfig = MemoryConfig::fromArray($config['memory'] ?? []);
        $guard = new MemoryGuard($memoryConfig);
        $averageItemBytes = (int)($argv[2] ?? 2048);
        echo json_encode([
            'average_item_bytes' => $averageItemBytes,
            'recommended_chunk_size' => $guard->recommendedChunkSize($averageItemBytes),
            'default_chunk_size' => $memoryConfig->defaultChunkSize(),
            'min_chunk_size' => $memoryConfig->minChunkSize(),
            'max_chunk_size' => $memoryConfig->maxChunkSize(),
        ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        break;
    case 'throughput:check':
        $throughputConfig = ThroughputConfig::fromArray($config['throughput'] ?? []);
        echo json_encode([
            'target_rps' => $throughputConfig->targetRequestsPerSecond(),
            'warning_latency_ms' => $throughputConfig->warningLatencyMs(),
            'critical_latency_ms' => $throughputConfig->criticalLatencyMs(),
            'max_concurrency' => $throughputConfig->maxConcurrency(),
            'queue_warning_depth' => $throughputConfig->queueWarningDepth(),
            'sample_window_seconds' => $throughputConfig->sampleWindowSeconds(),
        ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        break;
    case 'throughput:plan':
        $targetRps = (float)($argv[2] ?? (($config['throughput']['target_rps'] ?? 50)));
        $averageLatencyMs = (float)($argv[3] ?? 150);
        $maxConcurrency = (int)($argv[4] ?? (($config['throughput']['max_concurrency'] ?? 25)));
        $queueDepth = (int)($argv[5] ?? 0);
        $averageJobMs = (float)($argv[6] ?? 1000);
        echo json_encode(ThroughputPlanner::plan($targetRps, $averageLatencyMs, $maxConcurrency, $queueDepth, $averageJobMs), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
        break;
    case 'errors:sample-response':
        $config['app']['env'] = $config['app']['env'] ?? 'production';
        $config['app']['debug'] = false;
        $config['errors']['response_format'] = 'json';
        $logPath = ($config['paths']['logs'] ?? ($root . '/storage/logs')) . '/cli-error-sample.log';
        $handler = new SafeErrorHandler(new FileLogger($logPath), $config);
        $response = $handler->renderThrowable(new AppException('Internal CLI sample error token=secret', 'Sample safe error message.', 500, 'SAMPLE_ERROR'), new Request('GET', '/cli/errors/sample', [], [], ['accept' => 'application/json']));
        echo $response->body() . PHP_EOL;
        break;
    default:
        echo "MNB Secure Core v1.0.1 CLI\n";
        echo "Commands:\n";
        echo "  key:generate             Generate 64-char app key\n";
        echo "  config:validate          Validate security config shape, values, and safe combinations\n";
        echo "  check:production         Run production security readiness checks\n";
        echo "  doctor                   Run full security, package, runtime, storage, and scanner diagnostics\n";
        echo "  bootstrap:first-token    Issue first file/db/redis-backed API token: user_id scopes ttl [--write-demo-user]\n";
        echo "  secrets:scan             Scan project for accidental secrets\n";
        echo "  audit:verify            Verify tamper-evident audit hash chain
";
        echo "  audit:export            Export audit events as JSON: [category] [limit]
";
        echo "  logs:purge              Purge old log/audit files by retention policy: [channel]
";
        echo "  monitor:summary         Summarize audit integrity, metrics, and alerts
";
        echo "  monitor:alerts          Show monitoring alert rules and event count
";
        echo "  backup:create           Create encrypted/signed backup: [type]
";
        echo "  backup:verify           Verify backup integrity/signature: [path]
";
        echo "  backup:list             List backup archives
";
        echo "  backup:purge            Purge expired backups by retention policy
";
        echo "  recovery:status         Show backup and recovery readiness
";
        echo "  recovery:drill          Create backup and perform restore dry-run
";
        echo "  restore:dry-run         Verify restore plan without writing files: path
";
        echo "  incident:open           Open incident: type [severity]
";
        echo "  incident:run-playbook   Open and run incident playbook: name
";
        echo "  incident:report         Summarize incident cases and playbooks
";
        echo "  vulnerabilities:matrix   Export detailed vulnerability blocking matrix\n";
        echo "  vulnerabilities:report   Export vulnerability coverage score/report\n";
        echo "  vulnerabilities:check    Show controls, gaps, and advice for one vulnerability id\n";
        echo "  vulnerabilities:owasp    Group matrix rows by OWASP Top 10 mapping\n";
        echo "  vulnerabilities:export   Export vulnerability report as Markdown\n";
        echo "  matrix:export            Legacy alias for vulnerabilities:matrix\n";
        echo "  pentest:checklist        Export pentest checklist\n";
        echo "  pentest:payloads         Export safe pentest payload library\n";
        echo "  pentest:matrix           Export verification matrix\n";
        echo "  pentest:report-template  Print pentest report template\n";
        echo "  errors:sample-response   Show safe error response and write private error log\n";
        echo "  memory:check             Show PHP memory limit, thresholds, and current snapshot\n";
        echo "  memory:sample-plan       Show recommended chunk size for an item byte estimate\n";
        echo "  throughput:check         Show throughput thresholds and capacity settings\n";
        echo "  throughput:plan          Plan concurrency/workers: rps latency_ms concurrency queue_depth job_ms\n";
        break;
}
