        echo json_encode(['passed' => count(array_filter($errorIssues, fn(array $issue): bool => in_array($issue['level'], ['critical','high'], true))) === 0, 'issues' => $errorIssues], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
